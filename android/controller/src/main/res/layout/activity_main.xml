<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingBottom="8dp" />

    <AutoCompleteTextView
        android:id="@+id/serverUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="server URL (tap to pick)"
        android:completionThreshold="0"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Operator username"
        android:inputType="text"
        android:text="op" />

    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Login + list devices" />

        <Button
            android:id="@+id/refreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Refresh" />
    </LinearLayout>

    <!-- 6 preset tests in a 3×2 grid, then a full-width Stop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/startProbeBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:enabled="false" android:text="Probe" />

        <Button
            android:id="@+id/startRtUpBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:enabled="false" android:text="RT up" />

        <Button
            android:id="@+id/startRtDownBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:enabled="false" android:text="RT down" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/startBulkUpBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:enabled="false" android:text="Bulk up" />

        <Button
            android:id="@+id/startBulkDownBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:enabled="false" android:text="Bulk down" />

        <Button
            android:id="@+id/startFullBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:enabled="false" android:text="Full" />
    </LinearLayout>

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="Stop active test" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:textStyle="bold"
        android:text="Not logged in" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
