{
  "schema": "../../schemas/run_test_command.schema.json",
  "description": "Canonical RUN_TEST payloads. Every implementation that parses RUN_TEST MUST validate each example against the schema and round-trip it through its own DTOs without loss.",
  "examples": [

    {
      "name": "probe_only",
      "payload": {
        "test_id": "tst_01HZ8R9F0J2YK3P5Q7S9V1W3X5",
        "server_host": "10.0.0.1",
        "test_plan": {
          "name": "probe_only_v1",
          "version": 1,
          "duration_sec": 60,
          "flows": [
            {
              "flow_id": 1,
              "type": "probe",
              "server_port": 41000,
              "rate_pps": 10
            }
          ]
        }
      }
    },

    {
      "name": "mixed_realtime_and_bulk",
      "payload": {
        "test_id": "tst_01HZ8R9F0J2YK3P5Q7S9V1W3X6",
        "server_host": "10.0.0.1",
        "test_plan": {
          "name": "commute_v1",
          "version": 2,
          "duration_sec": 600,
          "flows": [
            {
              "flow_id": 1,
              "type": "probe",
              "server_port": 41000,
              "rate_pps": 10,
              "packet_size_bytes": 22
            },
            {
              "flow_id": 2,
              "type": "realtime_udp",
              "direction": "FromServer",
              "server_port": 41001,
              "rate_pps": 50,
              "packet_size_bytes": 200
            },
            {
              "flow_id": 3,
              "type": "bulk_tcp",
              "direction": "ToServer",
              "server_port": 41002
            }
          ]
        }
      },
      "notes": "Realistic commute-style plan: probe + downlink realtime + uplink bulk."
    },

    {
      "name": "bidirectional_realtime_as_two_flows",
      "payload": {
        "test_id": "tst_01HZ8R9F0J2YK3P5Q7S9V1W3X7",
        "server_host": "10.0.0.1",
        "test_plan": {
          "name": "rt_bidir_v1",
          "version": 1,
          "duration_sec": 120,
          "flows": [
            {
              "flow_id": 1,
              "type": "realtime_udp",
              "direction": "FromServer",
              "server_port": 41010,
              "rate_pps": 50,
              "packet_size_bytes": 200
            },
            {
              "flow_id": 2,
              "type": "realtime_udp",
              "direction": "ToServer",
              "server_port": 41011,
              "rate_pps": 50,
              "packet_size_bytes": 200
            }
          ]
        }
      },
      "notes": "Demonstrates the bidirectional-as-two-flows pattern (remediation 2.3). Distinct flow_ids, distinct ports."
    }

  ]
}
